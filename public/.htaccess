# ResumeStudio — Apache / LiteSpeed settings for shared hosting (e.g. Hostinger public_html).
# This file is copied into the build output (dist/frontend/browser) automatically.

Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS (also works behind Hostinger's proxy / CDN)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Real files and folders are served as they are
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Angular routes (/app/dashboard, /builder/…) load index.html.
  # Paths that look like files (/chunk-AB12CD34.js) are not rewritten, so a stale file gives a clean 404.
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed build files never change: cache for a year. index.html must always be fresh.
  <FilesMatch "-[A-Z0-9]{8}\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .mjs
  AddType image/svg+xml .svg
</IfModule>
