{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/favicon.ico", "/favicon.svg", "/manifest.webmanifest", "/styles-*.css", "/main-*.js", "/fonts/**"]
      }
    },
    {
      "name": "code",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/*.js", "/*.css", "/pdfjs/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/icons/**", "/*.png", "/*.svg"]
      }
    }
  ]
}
