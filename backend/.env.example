# ResumeStudio API settings. Copy to backend/.env for local development. In production set the same
# names as environment variables in the hosting panel (Hostinger: Node.js app → Environment variables).
# Required: DATABASE_URL, DATABASE_PASSWORD, JWT_SECRET. Commented lines show the defaults.

# ---- Server ----
# PORT=3000
# Browser origins allowed to call the API, comma separated (the Android app's https://localhost is always allowed).
# The first one is the public site address: the payment gateway sends buyers back there.
# FRONTEND_URL=http://localhost:4200
# Behind a reverse proxy (Hostinger, Nginx…) set 1 so rate limits see the real visitor IP
# TRUST_PROXY=1

# ---- Database (Supabase) ----
# Supabase → Connect → Direct → "Session pooler" (port 5432, works on IPv4-only hosts), pasted unchanged.
# [YOUR-PASSWORD] may stay: DATABASE_PASSWORD supplies the password, no URL-encoding needed.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase → Project Settings → Database → "Reset database password" if you do not know it
DATABASE_PASSWORD=
# SSL is automatic and verified for Supabase: true | false | verify | no-verify
# DATABASE_SSL=
# Connection pool size (the Supabase free plan allows 15 connections in total)
# DATABASE_MAX_CONNECTIONS=5
# Tables come from migrations (src/database/migrations); true lets TypeORM edit tables directly — experiments only
# DB_SYNC=false

# ---- Auth ----
# A long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# JWT_EXPIRES_IN_DAYS=7
# Sign-in/sign-up protection is on by default (lockouts, honeypot, password rules). Two parts can be tuned:
# invisible proof-of-work bot check (false only for debugging) and its difficulty (average hashes = half)
# AUTH_PROOF_OF_WORK=true
# AUTH_POW_MAX_NUMBER=50000
# Refuse new passwords found in the Have I Been Pwned breach list (only 5 hash characters are sent)
# PASSWORD_BREACH_CHECK=true
# Key that encrypts the authenticator-app secrets of two-factor sign-in (default: derived from JWT_SECRET).
# Set it once to a long random value and never change it — then JWT_SECRET can be rotated without
# turning everybody's 2FA unreadable.
# TWO_FACTOR_KEY=

# ---- Sign in with Google / Apple ----
# A provider's button appears only when all its settings are filled in (setup steps: README, "Sign in with
# Google / Apple"). Callback URLs are built from the first FRONTEND_URL, e.g.
#   https://YOUR-DOMAIN/api/auth/oauth/google/callback   and   https://YOUR-DOMAIN/api/auth/oauth/apple/callback
# Google Cloud console → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer: Services ID, Team ID, Key ID and the .p8 key (one line: write line breaks as \n)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- AI (OpenRouter) ----
# Key from https://openrouter.ai/keys (the account needs credits). Without it every AI feature uses the
# offline, rule-based assistant.
OPENROUTER_API_KEY=
# Any OpenRouter model id that supports structured outputs, e.g. anthropic/claude-haiku-4.5 (cheaper)
# or anthropic/claude-opus-5.5 (best quality)
AI_MODEL=anthropic/claude-sonnet-5.5
# Backup models, comma separated, tried when the main one is down or rate limited
# AI_FALLBACK_MODELS=

# ---- Files & PDF ----
# UPLOAD_DIR=uploads
# Chrome / Edge / Chromium for PDF export (auto-detected when empty)
# CHROME_PATH=

# ---- Plans, limits & support ----
# One-time price of lifetime access (PKR)
LIFETIME_PRICE_PKR=99
# Free plan per day, reset at midnight in APP_TIMEZONE; -1 = unlimited
FREE_DAILY_RESUMES=1
FREE_DAILY_COVER_LETTERS=1
FREE_DAILY_DOCUMENTS=1
# APP_TIMEZONE=Asia/Karachi
# AI requests per user per day (caps the OpenRouter bill); -1 = unlimited
AI_DAILY_LIMIT_FREE=20
AI_DAILY_LIMIT_LIFETIME=100
# WhatsApp number for payment questions, e.g. 03001234567 or 923001234567
SUPPORT_WHATSAPP=

# ---- Checkout: online payment gateway ----
# Checkout offers the gateway first ("Pay online") and the merchant QR code (public/payment/,
# approved in /app/admin) as the alternative. Empty = gateway off: checkout shows "Pay online" as
# coming soon and the QR code keeps working. mock = built-in test gateway, for development only
# (refused when NODE_ENV=production). A real gateway: add its adapter in src/checkout/gateways/,
# then set its key here plus its own credentials. Buyers return to the first FRONTEND_URL.
# PAYMENT_GATEWAY=
# Emails that can open /app/admin and approve payments, comma separated
ADMIN_EMAILS=
