# ---- Server ----
PORT=3000
# Comma separated list of allowed browser origins
FRONTEND_URL=http://localhost:4200
# Behind a reverse proxy (Nginx, Caddy, Hostinger) set to 1 so rate limits use the real visitor IP
# TRUST_PROXY=1

# ---- Database (Supabase PostgreSQL) ----
# Get from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Recommended: Transaction pooler (port 6543) or direct connection (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=true
# Auto create/update tables from entities in Supabase on startup
DB_SYNC=true
DATABASE_MAX_CONNECTIONS=10

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# ---- AI (Anthropic Claude) ----
# Without a key every AI feature still works in offline, rule-based mode.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best quality) or claude-sonnet-5 (faster / cheaper — recommended for a low-price plan)
AI_MODEL=claude-opus-5-5

# ---- Files & PDF ----
UPLOAD_DIR=uploads
# Optional: path to Chrome / Edge / Chromium for PDF export (auto-detected when empty)
CHROME_PATH=

# ---- Pricing & free plan ----
# One-time price for lifetime access (PKR)
LIFETIME_PRICE_PKR=99
# Daily limits for free users (reset at midnight in APP_TIMEZONE). Use -1 for unlimited.
FREE_DAILY_RESUMES=1
FREE_DAILY_COVER_LETTERS=1
FREE_DAILY_DOCUMENTS=1
APP_TIMEZONE=Asia/Karachi
# Fair-use cap on AI requests per user per day (protects your Anthropic bill). -1 = unlimited.
AI_DAILY_LIMIT_FREE=20
AI_DAILY_LIMIT_LIFETIME=100

# ---- Manual payments ----
# Checkout shows the JazzCash / Raast QR code from public/payment/ (npm run payment-qr in the
# frontend); buyers then submit their transaction ID for an admin to approve.
# Optional WhatsApp number for payment support, e.g. 923001234567
SUPPORT_WHATSAPP=

# ---- Admins (can approve payments at /app/admin) ----
ADMIN_EMAILS=
