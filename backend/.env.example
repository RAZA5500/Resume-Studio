# ---- Server ----
PORT=3000
# Comma separated list of allowed browser origins
FRONTEND_URL=http://localhost:4200
# Behind a reverse proxy (Nginx, Caddy, Hostinger) set to 1 so rate limits use the real visitor IP
# TRUST_PROXY=1

# ---- Database (Supabase PostgreSQL) ----
# Supabase -> Connect -> Direct -> "Session pooler" (port 5432, works on IPv4-only hosts such as
# Hostinger). Paste it unchanged: the user must be postgres.<project-ref>, and [YOUR-PASSWORD] may
# stay because DATABASE_PASSWORD below supplies the password (no URL-encoding needed).
# Leave DATABASE_URL empty to use the local docker-compose database instead.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase -> Project Settings -> Database -> "Reset database password" if you do not know it.
DATABASE_PASSWORD=
# SSL is automatic: Supabase certificates are verified with the bundled Supabase root CA.
# Override with true | false | verify | no-verify; DATABASE_SSL_CA=<file or PEM> adds a CA.
# DATABASE_SSL=
# Tables are created and updated by migrations at startup (src/database/migrations).
# DB_SYNC=true makes TypeORM alter tables straight from the entities — local experiments only.
DB_SYNC=false
# The Supabase free plan allows 15 pooled connections in total.
DATABASE_MAX_CONNECTIONS=5

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# ---- AI (Anthropic Claude) ----
# Without a key every AI feature still works in offline, rule-based mode.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best quality) or claude-sonnet-5 (faster / cheaper — recommended for a low-price plan)
AI_MODEL=claude-opus-5-5

# ---- Files & PDF ----
UPLOAD_DIR=uploads
# Optional: path to Chrome / Edge / Chromium for PDF export (auto-detected when empty)
CHROME_PATH=

# ---- Pricing & free plan ----
# One-time price for lifetime access (PKR)
LIFETIME_PRICE_PKR=99
# Daily limits for free users (reset at midnight in APP_TIMEZONE). Use -1 for unlimited.
FREE_DAILY_RESUMES=1
FREE_DAILY_COVER_LETTERS=1
FREE_DAILY_DOCUMENTS=1
APP_TIMEZONE=Asia/Karachi
# Fair-use cap on AI requests per user per day (protects your Anthropic bill). -1 = unlimited.
AI_DAILY_LIMIT_FREE=20
AI_DAILY_LIMIT_LIFETIME=100

# ---- Manual payments ----
# Checkout shows the JazzCash / Raast QR code from public/payment/ (npm run payment-qr in the
# frontend); buyers then submit their transaction ID for an admin to approve.
# Optional WhatsApp number for payment support, e.g. 923001234567
SUPPORT_WHATSAPP=

# ---- Admins (can approve payments at /app/admin) ----
ADMIN_EMAILS=
