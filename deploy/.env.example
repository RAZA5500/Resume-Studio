# =============================================================================
# ResumeStudio Production Environment (VPS / Hostinger)
# =============================================================================

# Your live domain pointing to this server IP (e.g. resumestudio.app or yourdomain.com)
DOMAIN=resumestudio.example.com

# ---- Supabase Cloud Database ----
# Supabase -> Connect -> Direct -> "Session pooler" string, pasted unchanged (user postgres.<project-ref>,
# port 5432). [YOUR-PASSWORD] may stay: DATABASE_PASSWORD supplies the password, no URL-encoding needed.
# SSL is automatic and verified. Tables are created by migrations when the API starts.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=

# ---- Security ----
# Generate a strong random key (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-very-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7

# ---- Admin Access ----
ADMIN_EMAILS=admin@example.com

# ---- Optional AI (Anthropic Claude) ----
# Without a key, all features work using the offline rule-based AI engine
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Pricing & Payments ----
LIFETIME_PRICE_PKR=99
PAYMENT_JAZZCASH_NUMBER=
PAYMENT_JAZZCASH_TITLE=
PAYMENT_EASYPAISA_NUMBER=
PAYMENT_EASYPAISA_TITLE=
PAYMENT_BANK_NAME=
PAYMENT_BANK_TITLE=
PAYMENT_BANK_ACCOUNT=
SUPPORT_WHATSAPP=
