# Caddy serves the Angular app and forwards /api to the NestJS container.
# With a real domain in DOMAIN, Caddy gets and renews the HTTPS certificate automatically.
# DOMAIN=:80 serves plain HTTP on the server IP (useful before your domain points here).

{$DOMAIN} {
	encode zstd gzip

	# Uploads (PDFs, images) can be up to 25 MB, JSON exports up to 30 MB
	request_body {
		max_size 32MB
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# Angular routes load index.html; paths that look like files are left alone (clean 404).
		@spa {
			not file
			not path *.*
		}
		rewrite @spa /index.html

		@hashed path_regexp \-[A-Z0-9]{8}\.(js|mjs|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"

		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stdout
		format console
		level WARN
	}
}
